{
  "name": "arrivalops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "bedrock:check": "vite-node scripts/bedrock-check.ts",
    "format": "prettier --write \"lib/arrivalops/**/*.ts\" \"app/components/desk/**/*.tsx\" \"app/components/desk/**/*.ts\" \"app/api/arrivalops/**/*.ts\" \"app/hooks/useArrivalOps.ts\" \"app/hooks/useFrameSampler.ts\" \"app/page.tsx\" \"app/layout.tsx\"",
    "format:check": "prettier --check \"lib/arrivalops/**/*.ts\" \"app/components/desk/**/*.tsx\" \"app/components/desk/**/*.ts\" \"app/api/arrivalops/**/*.ts\" \"app/hooks/useArrivalOps.ts\" \"app/hooks/useFrameSampler.ts\" \"app/page.tsx\" \"app/layout.tsx\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "next": "15.5.18",
    "onnxruntime-web": "^1.17.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.10.6",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "jpeg-js": "^0.4.4",
    "null-loader": "^4.0.1",
    "postcss": "8.5.10",
    "prettier": "^3.3.3",
    "tailwindcss": "3.4.0",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  }
}
